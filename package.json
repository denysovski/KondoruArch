{
  "name": "kondoru-arch",
  "version": "1.0.0",
  "private": true,
  "description": "Kondoru — a property and architecture site, built as a Next.js static export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finish-export.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-site.mjs",
    "test": "npm run typecheck && npm run build && npm run check",
    "images": "npm run images:ingest && npm run images:optimize",
    "images:ingest": "node scripts/ingest-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
